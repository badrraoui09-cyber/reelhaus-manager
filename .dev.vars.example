# Copy to .dev.vars for local development. Never commit .dev.vars.
GUARDIAN_API_TOKEN=replace-with-a-long-random-secret
ALLOW_LOCAL_BEARER_AUTH=true
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-audience-tag

# Keep draft_only until the full Gmail setup has been reviewed.
EMAIL_MODE=draft_only

# Gmail OAuth secrets. Leave empty while EMAIL_MODE=draft_only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
